# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.Python
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
*.key

# ---- Logs ----
*.log
cufile.log

